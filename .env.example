MOONCELL_SECRET_KEY=replace-with-a-long-random-string
MOONCELL_DATABASE_URL=sqlite+aiosqlite:///./data/mooncell.db
MOONCELL_SESSION_COOKIE_SECURE=false
MOONCELL_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MOONCELL_DOWNLOADS_PATH=./data/downloads
MOONCELL_LIBRARY_PATH=./data/library
MOONCELL_PLAYBACK_ENCODER=libx264
MOONCELL_PLAYBACK_CACHE_PATH=./data/playback
MOONCELL_PLAYBACK_MAX_SESSIONS=1
MOONCELL_PLAYBACK_SESSION_QUOTA_MB=512
MOONCELL_PLAYBACK_GLOBAL_QUOTA_MB=4096
MOONCELL_PLAYBACK_MIN_FREE_MB=512
TZ=Asia/Shanghai
